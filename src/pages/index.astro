---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/Hero.astro';
import FlagshipCase from '../components/sections/FlagshipCase.astro';
import Services from '../components/sections/Services.astro';
import LabTable from '../components/sections/LabTable.astro';
import ProcessAndProfile from '../components/sections/ProcessAndProfile.astro';
import Contact from '../components/sections/Contact.astro';
import esData from '../data/es.json';
---

<BaseLayout
  title={`${esData.brand} · ${esData.hero.badge}`}
  description={esData.hero.headline}
>
  <Hero />
  <FlagshipCase />
  <Services />
  <LabTable />
  <ProcessAndProfile />
  <Contact />
</BaseLayout>
