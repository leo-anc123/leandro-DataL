---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NodoIaSimulation from '../../components/dataviz/NodoIaSimulation';
import MulticriteriaMatrix from '../../components/dataviz/MulticriteriaMatrix';
import { getEntry } from 'astro:content';
import { siteConfig } from '../../config/site.config';

const caseEntry = await getEntry('cases', 'nodo-ia');
const entryData = caseEntry?.data ?? {
  title: "Caso Insignia: Nodo IA v2.1.0",
  tagline: "Localización óptima y simulación de carga para infraestructura de IA regional",
  date: new Date('2026-02-20'),
  version: "2.1.0",
  featured: true,
};

const Content = caseEntry ? (await caseEntry.render()).Content : null;
---

<BaseLayout 
  title={`${entryData.title} | Leandro DataL`}
  description={entryData.tagline}
>
  <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8 py-10 md:py-16">
    
    <!-- Top Bar: Back Link & Breadcrumb -->
    <div class="mb-8 flex items-center justify-between">
      <a 
        href="/#proyectos" 
        class="inline-flex items-center gap-2 font-mono text-xs font-medium text-text-secondary hover:text-accent-lime transition-colors group px-3 py-1.5 rounded border border-border-subtle bg-surface/60 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-lime"
      >
        <span class="group-hover:-translate-x-0.5 transition-transform">←</span>
        <span>Volver al inicio</span>
      </a>

      <div class="flex items-center gap-2 font-mono text-xs text-text-muted">
        <span>proyectos</span>
        <span>/</span>
        <span class="text-accent-lime">nodo-ia</span>
      </div>
    </div>

    <!-- Case Header Section -->
    <header class="border-b border-border-subtle pb-10 mb-12">
      <div class="flex flex-wrap items-center gap-3 mb-4">
        <span class="inline-flex items-center px-3 py-1 rounded-md text-xs font-mono font-medium tracking-wider uppercase bg-surface border border-accent-lime/40 text-accent-lime">
          CASO INSIGNIA · v{entryData.version}
        </span>
        <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono font-medium bg-accent-lime/10 border border-accent-lime/30 text-accent-lime">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-accent-lime opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-accent-lime"></span>
          </span>
          • En producción
        </span>
      </div>

      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-text-primary leading-tight mb-4">
        {entryData.title}
      </h1>

      <p class="text-lg sm:text-xl text-text-secondary leading-relaxed max-w-3xl mb-8">
        {entryData.tagline}
      </p>

      <!-- Metadata Strip -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 p-4 rounded-xl border border-border-subtle bg-surface/60 font-mono text-xs mb-8">
        <div>
          <span class="text-text-muted block text-[11px] uppercase tracking-wider mb-1">Metodología</span>
          <span class="text-text-primary font-medium">MCDA + Monte Carlo</span>
        </div>
        <div>
          <span class="text-text-muted block text-[11px] uppercase tracking-wider mb-1">Simulación</span>
          <span class="text-text-primary font-medium">10.000 iteraciones</span>
        </div>
        <div>
          <span class="text-text-muted block text-[11px] uppercase tracking-wider mb-1">Automatización</span>
          <span class="text-text-primary font-medium">GitHub Actions (100%)</span>
        </div>
        <div>
          <span class="text-text-muted block text-[11px] uppercase tracking-wider mb-1">Despliegue</span>
          <span class="text-accent-lime font-medium">Vercel Production</span>
        </div>
      </div>

      <!-- Action CTAs -->
      <div class="flex flex-wrap items-center gap-3">
        <a 
          href={siteConfig.social.demoNodoIa}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center font-medium text-sm px-5 py-2.5 rounded-lg bg-accent-lime text-background hover:bg-accent-lime-hover font-semibold transition-all shadow-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-lime"
        >
          <span>Ver demo en vivo</span>
          <span class="ml-1.5 text-xs">↗</span>
        </a>

        <a 
          href={siteConfig.social.github}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center font-mono text-xs px-4 py-2.5 rounded-lg text-text-secondary hover:text-text-primary border border-border-subtle bg-surface hover:bg-surface-subtle transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-lime"
        >
          <span>Repositorio en GitHub</span>
          <span class="ml-1.5">↗</span>
        </a>
      </div>
    </header>

    <!-- Interactive Dataviz Showcase -->
    <section class="mb-16 space-y-10">
      <div class="space-y-2">
        <span class="font-mono text-xs text-accent-lime uppercase tracking-wider">Simulación e Interactividad</span>
        <h2 class="text-2xl font-bold tracking-tight text-text-primary">Módulos Cuantitativos en Producción</h2>
        <p class="text-sm text-text-secondary max-w-2xl">
          Visualización de topología de nodos regionales y ponderación de criterios en tiempo real.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-start">
        <!-- Module 1: Graph Simulation -->
        <div class="p-5 rounded-xl border border-border-subtle bg-surface/80 space-y-4">
          <div class="flex items-center justify-between border-b border-border-subtle/80 pb-3">
            <span class="font-mono text-xs font-semibold text-text-primary">01 · Simulación Topológica y Monte Carlo</span>
            <span class="font-mono text-[11px] text-accent-lime bg-accent-lime/10 px-2 py-0.5 rounded border border-accent-lime/30">SVG 60 FPS</span>
          </div>
          <NodoIaSimulation client:load />
        </div>

        <!-- Module 2: MCDA Matrix -->
        <div class="p-5 rounded-xl border border-border-subtle bg-surface/80 space-y-4">
          <div class="flex items-center justify-between border-b border-border-subtle/80 pb-3">
            <span class="font-mono text-xs font-semibold text-text-primary">02 · Matriz de Decisión Multicriterio</span>
            <span class="font-mono text-[11px] text-accent-lime bg-accent-lime/10 px-2 py-0.5 rounded border border-accent-lime/30">5 Criterios (100%)</span>
          </div>
          <MulticriteriaMatrix client:load />
        </div>
      </div>
    </section>

    <!-- Case Study Deep Dive / Technical Content -->
    <article class="prose prose-invert max-w-none border-t border-border-subtle pt-12 space-y-10">
      
      <!-- Section: Context & Problem -->
      <section class="space-y-4">
        <h3 class="text-xl font-bold text-text-primary tracking-tight">Contexto y Definición del Problema</h3>
        <p class="text-text-secondary text-sm sm:text-base leading-relaxed">
          La instalación de infraestructura de cómputo intensivo para Inteligencia Artificial en Argentina enfrenta un espacio de decisión con alta incertidumbre en costos energéticos, estabilidad de red, disponibilidad de potencia en alta tensión y marcos regulatorios provinciales.
        </p>
        <p class="text-text-secondary text-sm sm:text-base leading-relaxed">
          Este sistema transforma variables energéticas, climáticas y de conectividad en una función de viabilidad probabilística, permitiendo comparar ubicaciones con sustento cuantitativo objetivo en lugar de heurísticas cualitativas.
        </p>
      </section>

      <!-- Section: Architecture & Pipeline -->
      <section class="space-y-4">
        <h3 class="text-xl font-bold text-text-primary tracking-tight">Arquitectura del Pipeline y Metodología</h3>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 pt-2">
          <div class="p-5 rounded-lg border border-border-subtle bg-surface space-y-2">
            <span class="font-mono text-accent-lime text-xs font-semibold uppercase tracking-wider block">Fase 1 · Ingesta</span>
            <h4 class="text-sm font-semibold text-text-primary">Ingesta y Validación de Datos</h4>
            <p class="text-xs text-text-secondary leading-relaxed">
              Extracción automatizada de registros energéticos y meteorológicos mediante scripts en Python con validación estricta de esquemas.
            </p>
          </div>

          <div class="p-5 rounded-lg border border-border-subtle bg-surface space-y-2">
            <span class="font-mono text-accent-lime text-xs font-semibold uppercase tracking-wider block">Fase 2 · Modelado</span>
            <h4 class="text-sm font-semibold text-text-primary">MCDA + Monte Carlo</h4>
            <p class="text-xs text-text-secondary leading-relaxed">
              Ponderación normalizada de 5 criterios estructurales e inyección de ruido estocástico sobre 10.000 iteraciones para rangos de confianza.
            </p>
          </div>

          <div class="p-5 rounded-lg border border-border-subtle bg-surface space-y-2">
            <span class="font-mono text-accent-lime text-xs font-semibold uppercase tracking-wider block">Fase 3 · Producto</span>
            <h4 class="text-sm font-semibold text-text-primary">Interfaz React & Vercel</h4>
            <p class="text-xs text-text-secondary leading-relaxed">
              Visualización reactiva en tiempo real construida en Astro y React, sin dependencias pesadas, compilada estáticamente para ultra-baja latencia.
            </p>
          </div>
        </div>
      </section>

      {Content && (
        <section class="mt-8 p-6 rounded-xl border border-border-subtle bg-surface/50 text-text-secondary text-sm leading-relaxed">
          <Content />
        </section>
      )}

      <!-- Tech Stack Used -->
      <section class="space-y-4 pt-6 border-t border-border-subtle">
        <h3 class="text-base font-bold text-text-primary tracking-tight">Tecnologías e Integraciones</h3>
        <div class="flex flex-wrap gap-2 text-xs font-mono">
          {['Python', 'DuckDB', 'Polars', 'MCDA (TOPSIS/AHP)', 'Simulación Monte Carlo', 'React', 'TypeScript', 'Astro', 'Tailwind CSS', 'GitHub Actions', 'Vercel'].map((tech) => (
            <span class="px-3 py-1.5 rounded-md bg-surface border border-border-subtle text-text-secondary">
              {tech}
            </span>
          ))}
        </div>
      </section>

    </article>

    <!-- Bottom Navigation -->
    <div class="mt-16 pt-8 border-t border-border-subtle flex flex-col sm:flex-row items-center justify-between gap-4">
      <a 
        href="/#proyectos" 
        class="inline-flex items-center gap-2 font-mono text-xs text-text-secondary hover:text-accent-lime transition-colors group px-4 py-2.5 rounded-lg border border-border-subtle bg-surface hover:bg-surface-subtle focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-lime"
      >
        <span class="group-hover:-translate-x-0.5 transition-transform">←</span>
        <span>Volver a la landing</span>
      </a>

      <a 
        href="/lab" 
        class="inline-flex items-center gap-2 font-mono text-xs font-semibold text-accent-lime hover:text-accent-lime-hover transition-colors group px-4 py-2.5 rounded-lg border border-accent-lime/30 bg-accent-lime/10 hover:bg-accent-lime/20 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-lime"
      >
        <span>Explorar todos los experimentos del Lab</span>
        <span class="group-hover:translate-x-0.5 transition-transform">→</span>
      </a>
    </div>

  </div>
</BaseLayout>
