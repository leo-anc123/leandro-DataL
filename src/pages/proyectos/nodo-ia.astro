---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NodoIaSimulation from '../../components/dataviz/NodoIaSimulation';
import MulticriteriaMatrix from '../../components/dataviz/MulticriteriaMatrix';
---

<BaseLayout title="Caso Insignia: Nodo IA | Leandro DataL">
  <article class="max-w-4xl mx-auto px-4 py-16">
    <h1 class="text-4xl font-bold text-white mb-4">Caso Insignia: Nodo IA v2.1.0</h1>
    <p class="text-gray-400 text-lg mb-8">Modelado estocástico y evaluación multicriterio para infraestructura regional.</p>
    <div class="space-y-8 my-8">
      <NodoIaSimulation client:load />
      <MulticriteriaMatrix client:load />
    </div>
  </article>
</BaseLayout>
