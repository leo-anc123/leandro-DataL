---
import esData from '../../data/es.json';
import { siteConfig } from '../../config/site.config';

const { hero } = esData;
---

<section class="relative pt-12 pb-20 md:pt-20 md:pb-28 overflow-hidden border-b border-border-subtle">
  <!-- Subtle ambient glow background -->
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[300px] bg-accent-lime/5 rounded-full blur-[120px] pointer-events-none -z-10"></div>

  <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      
      <!-- Columna Izquierda: Información Principal -->
      <div class="lg:col-span-7 flex flex-col items-start space-y-6">
        
        <!-- Header Badges: Technical Badge + Status Pill -->
        <div class="flex flex-wrap items-center gap-3">
          <!-- Technical Badge -->
          <span class="inline-flex items-center px-3 py-1 rounded-md text-xs font-mono font-medium tracking-wider uppercase bg-surface border border-border-subtle text-text-secondary">
            {hero.badge}
          </span>
          
          <!-- Status Pill: Disponible para proyectos -->
          <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono font-medium bg-accent-lime/10 border border-accent-lime/30 text-accent-lime">
            <span class="relative flex h-2 w-2">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-accent-lime opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-accent-lime"></span>
            </span>
            {hero.status}
          </span>
        </div>

        <!-- Headline -->
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-text-primary leading-[1.15]">
          {hero.headline}
        </h1>

        <!-- Subheadline -->
        <p class="text-base sm:text-lg text-text-secondary leading-relaxed max-w-2xl">
          {hero.subheadline}
        </p>

        <!-- CTAs -->
        <div class="flex flex-wrap items-center gap-3 pt-2">
          <!-- Primary CTA -->
          <a
            href="#proyectos"
            class="inline-flex items-center justify-center font-medium text-sm px-5 py-2.5 rounded-lg bg-accent-lime text-background hover:bg-accent-lime-hover font-semibold transition-all shadow-sm hover:shadow-accent-lime/20"
          >
            {hero.ctas.primary}
          </a>

          <!-- Secondary CTA: Iniciar una consulta -->
          <a
            href="#contacto"
            class="inline-flex items-center justify-center font-medium text-sm px-5 py-2.5 rounded-lg bg-surface hover:bg-surface-subtle text-text-primary border border-border-subtle hover:border-text-muted transition-all"
          >
            {hero.ctas.secondary}
          </a>

          <!-- Tertiary CTA: Descargar CV -->
          <a
            href={siteConfig.cvEsUrl ?? "#contacto"}
            class="inline-flex items-center justify-center font-mono text-xs px-4 py-2.5 rounded-lg text-text-secondary hover:text-text-primary border border-transparent hover:border-border-subtle transition-all"
          >
            {hero.ctas.downloadCv}
          </a>
        </div>

        <!-- Tech Stack Pills -->
        <div class="pt-4 border-t border-border-subtle/70 w-full flex flex-wrap items-center gap-2 text-xs font-mono text-text-muted">
          <span class="text-text-secondary font-medium mr-1">Stack:</span>
          {hero.tags.map((tag, idx) => (
            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded bg-surface/80 border border-border-subtle text-text-secondary">
              {tag}
              {idx < hero.tags.length - 1 && <span class="text-border-subtle ml-1">•</span>}
            </span>
          ))}
        </div>

      </div>

      <!-- Columna Derecha: Contenedor Estilizado con Slot para Turno 3 -->
      <div class="lg:col-span-5 w-full">
        <div class="relative rounded-xl border border-border-subtle bg-surface/90 shadow-2xl p-5 md:p-6 min-h-[380px] md:min-h-[420px] flex flex-col justify-between overflow-hidden">
          {/* SLOT: NodoIaSimulation (Turno 3) */}
          
          <!-- Terminal/Simulation Header -->
          <div class="flex items-center justify-between border-b border-border-subtle pb-3">
            <div class="flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-red-500/80"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-yellow-500/80"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-accent-lime/80"></span>
              <span class="ml-2 font-mono text-xs text-text-secondary">{hero.cardPreview.title}</span>
            </div>
            <span class="inline-flex items-center gap-1.5 font-mono text-[11px] text-accent-lime bg-accent-lime/10 px-2 py-0.5 rounded border border-accent-lime/20">
              <span class="w-1.5 h-1.5 rounded-full bg-accent-lime animate-pulse"></span>
              {hero.cardPreview.status}
            </span>
          </div>

          <!-- Simulation Graphic Mockup Area -->
          <div class="py-8 flex flex-col items-center justify-center space-y-6 flex-grow">
            <!-- Simulated chart curves & distributions -->
            <div class="w-full space-y-3">
              <div class="flex items-center justify-between text-[11px] font-mono text-text-muted">
                <span>P10 (Bajo)</span>
                <span>P50 (Base)</span>
                <span>P90 (Alto)</span>
              </div>
              <div class="grid grid-cols-3 gap-2 h-20 items-end">
                <div class="bg-surface-subtle border border-border-subtle rounded-t h-[45%] flex items-end justify-center pb-1">
                  <span class="font-mono text-[10px] text-text-muted">45%</span>
                </div>
                <div class="bg-accent-lime/20 border border-accent-lime/40 rounded-t h-[88%] flex items-end justify-center pb-1 relative">
                  <span class="font-mono text-[10px] text-accent-lime font-bold">88%</span>
                </div>
                <div class="bg-surface-subtle border border-border-subtle rounded-t h-[65%] flex items-end justify-center pb-1">
                  <span class="font-mono text-[10px] text-text-muted">65%</span>
                </div>
              </div>
            </div>

            <!-- Scenarios chips -->
            <div class="flex items-center justify-center gap-2 flex-wrap">
              {hero.cardPreview.scenarios.map((sc) => (
                <span class="font-mono text-[11px] px-2.5 py-1 rounded bg-surface-subtle text-text-secondary border border-border-subtle">
                  {sc}
                </span>
              ))}
            </div>
          </div>

          <!-- Card Footer -->
          <div class="pt-3 border-t border-border-subtle flex items-center justify-between text-[11px] font-mono text-text-muted">
            <span>{hero.cardPreview.footerTag}</span>
            <span class="italic text-[10px]">{hero.cardPreview.caption}</span>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
