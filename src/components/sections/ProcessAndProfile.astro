---
import esData from '../../data/es.json';

const { process, profile } = esData;
---

<section id="perfil" class="py-20 md:py-28 border-b border-border-subtle bg-background">
  <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8 space-y-24">
    
    <!-- Bloque 1: CÓMO TRABAJO (Ciclo 01 al 04) -->
    <div>
      <div class="flex flex-col items-start space-y-3 mb-12">
        <span class="inline-flex items-center px-3 py-1 rounded-md text-xs font-mono font-medium tracking-wider uppercase bg-surface border border-border-subtle text-text-secondary">
          {process.badge}
        </span>
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight text-text-primary">
          {process.title}
        </h2>
      </div>

      <!-- 4 Steps Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {process.steps.map((item) => (
          <div class="rounded-xl border border-border-subtle bg-surface/70 hover:border-border-subtle/80 p-6 flex flex-col justify-between space-y-4 relative group">
            <div class="space-y-3">
              <span class="font-mono text-2xl font-bold text-accent-lime">
                {item.step}
              </span>
              <h3 class="text-base font-semibold text-text-primary tracking-tight">
                {item.title}
              </h3>
            </div>
            <p class="text-xs sm:text-sm text-text-secondary leading-relaxed">
              {item.description}
            </p>
          </div>
        ))}
      </div>
    </div>

    <!-- Bloque 2: PERFIL TÉCNICO Y STACK -->
    <div class="pt-8 border-t border-border-subtle/70">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
        
        <!-- Info Izquierda: Bio & Educación -->
        <div class="lg:col-span-5 space-y-6">
          <span class="inline-flex items-center px-3 py-1 rounded-md text-xs font-mono font-medium tracking-wider uppercase bg-surface border border-border-subtle text-text-secondary">
            {profile.badge}
          </span>
          <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-text-primary leading-tight">
            {profile.title}
          </h2>
          <p class="text-sm sm:text-base text-text-secondary leading-relaxed">
            {profile.bio}
          </p>

          <!-- Education Highlight Pill -->
          <div class="inline-flex items-center gap-2 px-3.5 py-2 rounded-lg bg-surface border border-accent-lime/30 text-xs font-mono text-text-primary">
            <span class="w-2 h-2 rounded-full bg-accent-lime"></span>
            <span>{profile.education}</span>
          </div>
        </div>

        <!-- Info Derecha: Categorías de Stack -->
        <div class="lg:col-span-7 space-y-4">
          {profile.stack.map((group) => (
            <div class="rounded-xl border border-border-subtle bg-surface p-5 sm:p-6 space-y-2">
              <span class="font-mono text-[11px] font-semibold uppercase tracking-wider text-accent-lime block">
                {group.category}
              </span>
              <p class="font-mono text-xs sm:text-sm text-text-secondary leading-relaxed">
                {group.skills}
              </p>
            </div>
          ))}
        </div>

      </div>
    </div>

  </div>
</section>
