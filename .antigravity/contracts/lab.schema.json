{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LabDataLItem",
  "type": "object",
  "required": [
    "id",
    "title",
    "date",
    "status",
    "tags",
    "summary"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "completed",
        "in-progress",
        "planned"
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "summary": {
      "type": "string"
    },
    "demoUrl": {
      "type": "string"
    },
    "repoUrl": {
      "type": "string"
    }
  }
}